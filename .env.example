# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# ID du skill (console développeur Alexa > ton skill > "Skill ID")
ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx

# Vérification des requêtes Alexa — laisse "true" (mettre false seulement pour tester en local)
VERIFY_ALEXA=true

# Modèles : un rapide pour la voix, un plus fort pour les schémas
VOICE_MODEL=claude-haiku-5-5
VISUAL_MODEL=claude-sonnet-5-5
VOICE_TIMEOUT=6

# Ce que Evy sait de toi (adapte le niveau des explications)
USER_CONTEXT=L'utilisateur est étudiant en master IA / vision par ordinateur : tu peux être technique et précis.

# HDMI-CEC : /dev/cec0 = port micro-HDMI 0 de la Pi 5, /dev/cec1 = port 1
CEC_ENABLED=true
CEC_DEVICE=/dev/cec0
# À remplir seulement si la télé ne bascule pas toute seule sur la Pi (ex. 1.0.0.0, 2.0.0.0…)
CEC_PHYS_ADDR=

PORT=5000
